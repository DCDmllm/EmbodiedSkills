{
  "name": "embodiedskills_rmbench",
  "task": {
    "instruction": null,
    "default_stage": "observe"
  },
  "models": {
    "vision": {
      "backend": "openai_compatible",
      "model": "${VLM_MODEL}",
      "api_base_url": null,
      "api_base_url_env": "OPENAI_COMPATIBLE_API_BASE_URL",
      "api_key": null,
      "api_key_env": "OPENAI_COMPATIBLE_API_KEY",
      "max_new_tokens": 2048,
      "temperature": 0.0,
      "request_timeout": 1800.0,
      "reasoning_effort": "medium"
    },
    "state": {
      "backend": "openai_compatible",
      "model": "${VLM_MODEL}",
      "api_base_url": null,
      "api_base_url_env": "OPENAI_COMPATIBLE_API_BASE_URL",
      "api_key": null,
      "api_key_env": "OPENAI_COMPATIBLE_API_KEY",
      "max_new_tokens": 2048,
      "temperature": 0.0,
      "request_timeout": 1800.0,
      "reasoning_effort": "medium"
    },
    "scheduler": {
      "backend": "openai_compatible",
      "model": "${VLM_MODEL}",
      "api_base_url": null,
      "api_base_url_env": "OPENAI_COMPATIBLE_API_BASE_URL",
      "api_key": null,
      "api_key_env": "OPENAI_COMPATIBLE_API_KEY",
      "max_new_tokens": 2048,
      "temperature": 0.0,
      "request_timeout": 1800.0,
      "reasoning_effort": "medium"
    },
    "safety": {
      "backend": "none",
      "model": null
    },
    "motion": {
      "backend": "none",
      "model": null
    },
    "verifier": {
      "backend": "openai_compatible",
      "model": "${VLM_MODEL}",
      "api_base_url": null,
      "api_base_url_env": "OPENAI_COMPATIBLE_API_BASE_URL",
      "api_key": null,
      "api_key_env": "OPENAI_COMPATIBLE_API_KEY",
      "max_new_tokens": 2048,
      "temperature": 0.0,
      "request_timeout": 1800.0,
      "reasoning_effort": "medium"
    },
    "recovery": {
      "backend": "openai_compatible",
      "model": "${VLM_MODEL}",
      "api_base_url": null,
      "api_base_url_env": "OPENAI_COMPATIBLE_API_BASE_URL",
      "api_key": null,
      "api_key_env": "OPENAI_COMPATIBLE_API_KEY",
      "max_new_tokens": 2048,
      "temperature": 0.0,
      "request_timeout": 1800.0,
      "reasoning_effort": "medium"
    }
  },
  "components": {
    "vision": {
      "enabled": true,
      "model": "vision",
      "prompt_format": "json",
      "skills": [
        "capture_views",
        "perceive_scene",
        "localize_task_objects",
        "refresh_preflight_observation",
        "render_grounding_overlay",
        "lift_depth_cluster",
        "lift_geometry",
        "bind_arm",
        "estimate_uncertainty"
      ]
    },
    "state": {
      "enabled": true,
      "model": "state",
      "prompt_format": "json",
      "skills": [
        "update_world_state",
        "summarize_state"
      ]
    },
    "scheduler": {
      "enabled": true,
      "model": "scheduler",
      "prompt_format": "json",
      "skills": [
        "select_next_component",
        "choose_next_skill",
        "build_task_plan",
        "select_current_subgoal",
        "advance_subgoal",
        "allocate_budget",
        "repair_stage_transition"
      ]
    },
    "safety": {
      "enabled": true,
      "model": "safety",
      "prompt_format": "json",
      "skills": [
        "validate_skill_request",
        "validate_arm_binding",
        "check_reachability",
        "check_workspace",
        "preflight_action"
      ]
    },
    "motion": {
      "enabled": true,
      "model": "motion",
      "prompt_format": "json",
      "skills": [
        "build_motion_goal",
        "plan_motion",
        "emit_action_chunk",
        "execute_action"
      ]
    },
    "verifier": {
      "enabled": true,
      "model": "verifier",
      "prompt_format": "json",
      "skills": [
        "verify_progress"
      ]
    },
    "recovery": {
      "enabled": true,
      "model": "recovery",
      "prompt_format": "json",
      "skills": [
        "decide_recovery",
        "build_retry_request"
      ]
    }
  },
  "stages": [
    {
      "name": "observe",
      "description": "Collect and interpret current public observations."
    },
    {
      "name": "plan",
      "description": "Select the next component and skill from shared state."
    },
    {
      "name": "preflight",
      "description": "Validate safety, binding, workspace, and reachability before motion."
    },
    {
      "name": "execute",
      "description": "Run a bounded motion/control skill."
    },
    {
      "name": "verify",
      "description": "Check progress and residuals from before/after observations."
    },
    {
      "name": "recover",
      "description": "Recover or replan after a failed or uncertain step."
    }
  ],
  "environment": {
    "type": "rmbench",
    "artifact_dir": "${EMBODIEDSKILLS_ARTIFACTS}/rmbench",
    "task_name": "${TASK_NAME}",
    "seed": 0
  },
  "robotwin": {
    "repo_root": "${RMBENCH_ROOT}",
    "task_name": "${TASK_NAME}",
    "task_config": "${TASK_CONFIG}",
    "seed": 0,
    "now_ep_num": 0,
    "enable_depth": true,
    "enable_pointcloud": true,
    "enable_actor_segmentation": false,
    "enable_mesh_segmentation": false,
    "camera_profile": "Large_D435_Wide",
    "planner_image_mode": "current_rgb_4",
    "static_camera_preset": "selected_global_4",
    "artifact_dir": "${EMBODIEDSKILLS_ARTIFACTS}/rmbench"
  },
  "runtime_environment": {
    "conda_env": "robotwin-py312",
    "conda_bin": "${CONDA_BIN}",
    "pythonpath_prefix": [
      "${PYTORCH3D_SRC}",
      "${EMBODIEDSKILLS_ROOT}/src",
      "${OPENPI_SRC}"
    ],
    "env": {
      "__EGL_VENDOR_LIBRARY_DIRS": "/usr/share/glvnd/egl_vendor.d",
      "VK_ICD_FILENAMES": "/etc/vulkan/icd.d/nvidia_icd.json"
    }
  },
  "metadata": {
    "action_backend": {
      "type": "pi05",
      "enabled": true,
      "policy_type": "pi05",
      "pretrained_path": "${PI05_CHECKPOINT}",
      "device": "cuda",
      "openpi_src": "${OPENPI_SRC}",
      "tokenizer_name": "${PI05_TOKENIZER}",
      "policy_kwargs": {
        "n_action_steps": 32,
        "sample_num_steps": 10,
        "action_horizon": 32,
        "max_token_len": 256,
        "train_config_name": "embodiedskills_pi05_subtasks",
        "asset_id": "embodiedskills_pi05_subtasks"
      },
      "openpi_runtime": {
        "mode": "worker",
        "conda_bin": "${CONDA_BIN}",
        "conda_env": "openpi-torch-py312",
        "config_path": "${EMBODIEDSKILLS_ROOT}/configs/runtime/rmbench.json",
        "pythonpath": "${EMBODIEDSKILLS_ROOT}/src:${OPENPI_SRC}",
        "cuda_visible_devices": "${OPENPI_CUDA_VISIBLE_DEVICES}",
        "host": "127.0.0.1",
        "port": 8765,
        "timeout": 600.0
      },
      "lerobot_env": {
        "task": "libero_object",
        "obs_type": "pixels_agent_pos"
      },
      "robotwin_adapter": {
        "mode": "openpi_robotwin2",
        "action_type": "qpos",
        "uses_delta_joint_actions": true,
        "image_mapping": {
          "images.cam_high": "head_camera",
          "images.cam_left_wrist": "left_camera",
          "images.cam_right_wrist": "right_camera"
        },
        "state_mapping": "joint_action.vector"
      }
    }
  }
}
