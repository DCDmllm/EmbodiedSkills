      "temperature": 0.0,
      "request_timeout": 1800.0,
      "reasoning_effort": "medium"
    }
  },
  "components": {
    "vision": {
      "enabled": true,
      "model": "vision",
      "prompt_format": "json",
      "skills": [
        "capture_views",
        "perceive_scene",
        "localize_task_objects",
        "refresh_preflight_observation",
        "render_grounding_overlay",
        "lift_depth_cluster",
        "lift_geometry",
        "bind_arm",
        "estimate_uncertainty"
      ]
    },
    "state": {
      "enabled": true,
      "model": "state",
      "prompt_format": "json",
      "skills": [
        "update_world_state",
        "summarize_state"
      ]
    },
    "scheduler": {
      "enabled": true,
      "model": "scheduler",
      "prompt_format": "json",
      "skills": [
        "select_next_component",
        "choose_next_skill",
        "build_task_plan",
        "select_current_subgoal",
        "advance_subgoal",
        "allocate_budget",
        "repair_stage_transition"
      ]
    },
    "safety": {
      "enabled": true,
      "model": "safety",
      "prompt_format": "json",
      "skills": [
        "validate_skill_request",
        "validate_arm_binding",
        "check_reachability",
        "check_workspace",
        "preflight_action"
      ]
    },
    "motion": {
      "enabled": true,
      "model": "motion",
      "prompt_format": "json",
      "skills": [
        "build_motion_goal",
        "plan_motion",
        "emit_action_chunk",
        "execute_action"
      ]
    },
    "verifier": {
      "enabled": true,
      "model": "verifier",
      "prompt_format": "json",
      "skills": [
        "verify_progress"
      ]
    },
    "recovery": {
      "enabled": true,
      "model": "recovery",
      "prompt_format": "json",
      "skills": [
        "decide_recovery",
        "build_retry_request"
      ]
    }
  },
  "stages": [
    {
      "name": "observe",
      "description": "Collect and interpret current public observations."
    },
    {
      "name": "plan",
      "description": "Select the next component and skill from shared state."
    },
    {
      "name": "preflight",
      "description": "Validate safety, binding, workspace, and reachability before motion."
    },
    {
      "name": "execute",
      "description": "Run a bounded motion/control skill."
    },
    {
      "name": "verify",
      "description": "Check progress and residuals from before/after observations."
    },
    {
      "name": "recover",
      "description": "Recover or replan after a failed or uncertain step."
    }
  ],
  "environment": {
    "type": "robocasa",
    "artifact_dir": "/mnt/wangwai/vla/clawvla/tmp_artifacts/robocasa",
    "task_name": "robocasa/PickPlaceCounterToCabinet",
