# Repository and benchmark roots.
EMBODIEDSKILLS_ROOT=/path/to/EmbodiedSkills
EMBODIEDSKILLS_ARTIFACTS=/path/to/EmbodiedSkills/artifacts
ROBOTWIN_ROOT=/path/to/RoboTwin
RMBENCH_ROOT=/path/to/rmbench
OPENPI_SRC=/path/to/openpi/src
LEROBOT_SRC=/path/to/lerobot/src
PYTORCH3D_SRC=/optional/path/to/pytorch3d

# Runtime models.
VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
PI05_CHECKPOINT=/path/to/pi05/checkpoint
PI05_TOKENIZER=/path/to/paligemma_tokenizer.model
OPENPI_CUDA_VISIBLE_DEVICES=0
TASK_NAME=place_container_plate
TASK_CONFIG=demo_clean

# Conda and OpenPI worker environment.
CONDA_BIN=conda
OPENPI_PYTHONPATH=/path/to/EmbodiedSkills/src:/path/to/openpi/src

# Remote OpenAI-compatible endpoint, only needed when not using local vLLM.
OPENAI_COMPATIBLE_API_BASE_URL=http://host:port/v1
OPENAI_COMPATIBLE_API_KEY=replace-me
